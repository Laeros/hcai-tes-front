{
  "manifest_version": 3,
  "name": "HCAI e-Learning Assistant para Google Classroom",
  "version": "1.0.0",
  "description": "Panel adaptativo (HCAI) con Taxonomía de Bloom, recomendaciones y telemetría conductual anonimizada para Google Classroom.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://classroom.google.com/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
